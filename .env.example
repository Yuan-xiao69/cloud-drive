# ============================================
# GitHub Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# IMPORTANT: Never commit .env to version control!

# Node Environment
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_platform

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3 Compatible Storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=github-platform
S3_PUBLIC_URL=http://localhost:9000/github-platform

# ============================================
# JWT Configuration (CRITICAL FOR SECURITY)
# ============================================
# Generate secure random strings for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Access Token Secret (15min expiry)
JWT_SECRET=your_access_token_secret_here_min_32_chars

# Refresh Token Secret (7d expiry)
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars

# ============================================
# Encryption Key (CRITICAL FOR SECURITY)
# ============================================
# Used to encrypt sensitive data like email passwords
# Generate secure key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

# ============================================
# Email SMTP Configuration (Optional - can also configure via Admin Panel)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password-or-auth-code
# SMTP_FROM=代码平台 <noreply@example.com>

# ============================================
# Application
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Super Admin (created on first run if not exists)
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_EMAIL=root@example.com
ROOT_ADMIN_PASSWORD=change_this_password
